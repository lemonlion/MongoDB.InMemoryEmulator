<Project>
	<!-- Shared build settings for all projects -->
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- Suppress transitive dep advisories from MongoDB.Driver where no patched version exists
	     and this project never calls the affected APIs. -->
	<ItemGroup>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6c8g-7p36-r338" /> <!-- SharpCompress WriteToDirectory -->
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pggp-6c3x-2xmx" /> <!-- Snappier (transitive from MongoDB.Driver 2.x) -->
	</ItemGroup>
</Project>
