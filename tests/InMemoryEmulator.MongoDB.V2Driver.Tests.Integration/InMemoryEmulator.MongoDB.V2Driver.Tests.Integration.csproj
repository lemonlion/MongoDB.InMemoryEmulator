<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<NoWarn>$(NoWarn);CS0618</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="InMemoryEmulator.MongoDB.Tests.Infrastructure" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Link ALL test source files from the V3 integration project -->
	<ItemGroup>
		<Compile Include="..\InMemoryEmulator.MongoDB.Tests.Integration\**\*.cs" LinkBase="" Exclude="..\InMemoryEmulator.MongoDB.Tests.Integration\IntegrationCollection.cs;..\InMemoryEmulator.MongoDB.Tests.Integration\JavaScriptExpressionTests.cs;..\InMemoryEmulator.MongoDB.Tests.Integration\Crud\InMemoryMongoFactoryTests.cs;..\InMemoryEmulator.MongoDB.Tests.Integration\SdkVersionDriftDetectorTests.cs;..\InMemoryEmulator.MongoDB.Tests.Integration\obj\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" Version="9.4.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\InMemoryEmulator.MongoDB.V2Driver.Tests.Shared\InMemoryEmulator.MongoDB.V2Driver.Tests.Shared.csproj" />
	</ItemGroup>

</Project>
